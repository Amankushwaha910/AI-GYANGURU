# ============================================================
# AI GyanGuru — Backend Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# Application
APP_NAME=AI GyanGuru
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-super-secret-key-change-this-in-production
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=gyanguru-uploads

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Provider (Groq — required)
# Use Developer-plan models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# Note: llama-3.3-70b-versatile requires Enterprise plan and will return 404 on standard accounts.
GROQ_API_KEY=your-groq-api-key
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
AI_PROVIDER=groq
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=60

# Additional AI Providers (optional — leave empty to disable)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# OCR Engine (paddleocr or tesseract)
OCR_ENGINE=paddleocr
TESSERACT_CMD=/usr/bin/tesseract

# File Upload
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg,webp

# Rate Limiting
RATE_LIMIT_GENERAL=60/minute
RATE_LIMIT_AI=10/minute

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
