{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": null
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s"
    },
    "request_timing": {
      "format": "%(asctime)s | %(levelname)s | %(name)s | %(message)s"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "request_timing_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": ".runtime-logs/request-timing/requests.log",
      "maxBytes": 2097152,
      "backupCount": 3,
      "encoding": "utf-8",
      "formatter": "request_timing"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["default"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    },
    "gyanguru": {
      "handlers": ["request_timing_file"],
      "level": "NOTSET",
      "propagate": true
    }
  }
}
